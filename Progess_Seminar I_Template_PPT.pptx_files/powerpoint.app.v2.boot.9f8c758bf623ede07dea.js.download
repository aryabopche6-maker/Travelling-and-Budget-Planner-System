root {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #fff;\n    font-family: "Segoe UI", sans-serif;\n    box-sizing: border-box;\n  }\n  .ppt-skel-root *, .ppt-skel-root *::before, .ppt-skel-root *::after {\n    box-sizing: border-box;\n  }\n  .ppt-skel-header {\n    flex: 0 0 48px;\n    background: #F5F5F5;\n  }\n  .ppt-skel-ribbon {\n    flex: 0 0 auto;\n    background: #F5F5F5;\n    border-bottom: 1px solid #E1E1E1;\n  }\n  .ppt-skel-geometry-parity .ppt-skel-ribbon {\n    border-bottom: 0;\n  }\n  .ppt-skel-ribbon-menu {\n    position: relative;\n    left: 0;\n    right: 0;\n    height: 30px;\n    background: #F5F5F5;\n    overflow: hidden;\n  }\n  .ppt-skel-ribbon-commands {\n    position: relative;\n    height: 106px;\n    background: white;\n    margin: 0 8px;\n    border-radius: 8px;\n\n    overflow: hidden;\n  }\n  .ppt-skel-shimmer-rect {\n    position: absolute;\n    forced-color-adjust: none;\n    background: #EBEBEB;\n    border-radius: 2px;\n  }\n  /* Intermediate containers for tab row shimmer groups - matching Hermes.css */\n  .ppt-skel-shimmer-blocks-left {\n    position: absolute;\n    width: 39.4%;\n    height: 44.4%;\n    left: 0.7%;\n    top: 27.8%;\n  }\n  .ppt-skel-shimmer-blocks-left-rtl {\n    position: absolute;\n    width: 39.4%;\n    height: 44.4%;\n    left: 59%;\n    top: 27.8%;\n  }\n  .ppt-skel-shimmer-collab-corner {\n    position: absolute;\n    left: 79.84%;\n    right: 0%;\n    top: 11.11%;\n    bottom: 11.11%;\n  }\n  .ppt-skel-shimmer-collab-corner-rtl {\n    position: absolute;\n    left: 0%;\n    width: 20.16%;\n    top: 11.11%;\n    bottom: 11.11%;\n  }\n  .ppt-skel-shimmer-collab-blocks {\n    position: absolute;\n    width: 91.4%;\n    height: 85.7%;\n    left: 6.4%;\n    top: 7.1%;\n  }\n  .ppt-skel-shimmer-collab-blocks .ppt-skel-shimmer-rect {\n    top: 7.1%;\n  }\n  .ppt-skel-shimmer-ellipse {\n    border-radius: 50%;\n  }\n  .ppt-skel-shimmer-blocks {\n    position: absolute;\n    width: 97.1%;\n    height: 69.23%;\n    left: 0.7%;\n    top: 8.6%;\n  }\n  /* MLR-specific heights - match server-side percentages (25.71% menu, 74.29% commands of 136px) */\n  .ppt-skel-ribbon-mlr .ppt-skel-ribbon-menu {\n    height: 35px;\n  }\n  .ppt-skel-ribbon-mlr .ppt-skel-ribbon-commands {\n    height: 101px;\n  }\n  /* MLR shimmer blocks width - from Hermes.css ribbonShimmerCommandsBlocksMLR */\n  .ppt-skel-ribbon-mlr .ppt-skel-shimmer-blocks {\n    width: 76.7%;\n  }\n    /* SLR-specific overrides */\n  .ppt-skel-ribbon-slr .ppt-skel-ribbon-menu {\n    height: 36.5px; /* 47.37% of 77px total SLR ribbon height */\n  }\n  .ppt-skel-ribbon-slr .ppt-skel-ribbon-commands {\n    height: 40.5px; /* 52.63% of 77px total SLR ribbon height */\n    background: white;\n    border-radius: 8px;\n    margin: 0 8px;\n  }\n  /* SLR shimmer blocks - from Hermes.css ribbonShimmerCommandsBlocksSLR */\n  .ppt-skel-ribbon-slr .ppt-skel-shimmer-blocks {\n    width: 97.1%;\n    height: 55%;\n    left: 0.7%;\n    top: 22.5%;\n  }\n  .ppt-skel-body {\n    flex: 1 1 auto;\n    display: flex;\n    overflow: hidden;\n  }\n  .ppt-skel-thumbnails {\n    flex: 0 0 238px;\n    background: #F4F4F4;\n    border-right: 1px solid #E1E1E1;\n    position: relative;\n    overflow: hidden;\n  }\n  .ppt-skel-geometry-parity.ppt-skel-horizontal-handoff-parity .ppt-skel-thumbnails {\n    box-sizing: content-box;\n    border-right-width: 2px;\n  }\n  .ppt-skel-thumbnail-container {\n    position: absolute;\n    width: 184px;\n    height: 96%;\n    left: 33px;\n    top: 20px;\n    background: linear-gradient(270.44deg, #F3F2F1 0%, #EDEBE9 50%, #F3F2F1 100%);\n  }\n  [dir="rtl"] .ppt-skel-thumbnail {\n    -webkit-animation-name: ppt-skel-thumb-shimmer-rtl;\n    animation-name: ppt-skel-thumb-shimmer-rtl;\n  }\n  .ppt-skel-slide-pane,\n  .WACDocumentPanelContent {\n    flex: 1 1 auto;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #f0f0f0;\n    overflow: hidden;\n    position: relative;\n  }\n  .ppt-skel-slide,\n  .WireframeBootSlideView {\n    position: absolute;\n    background: #fff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.3);\n    border: solid 1px transparent;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    max-width: calc(100% - 20px);\n    max-height: calc(100% - 20px);\n    z-index: 100;\n  }\n  .ppt-skel-geometry-parity .ppt-skel-slide,\n  .ppt-skel-geometry-parity .WireframeBootSlideView {\n    box-sizing: content-box;\n  }\n  .ppt-skel-canvas-visual-refresh,\n  .ppt-skel-canvas-visual-refresh .ppt-skel-slide-pane,\n  .ppt-skel-canvas-visual-refresh .ppt-skel-thumbnails {\n    background: #F5F5F5;\n  }\n  .ppt-skel-canvas-fluent-ui-refresh,\n  .ppt-skel-canvas-fluent-ui-refresh .ppt-skel-slide-pane,\n  .ppt-skel-canvas-fluent-ui-refresh .ppt-skel-thumbnails {\n    background: #FCFCFC;\n  }\n  .ppt-skel-canvas-dark {\n    background: #000;\n    color: #fff;\n  }\n  .ppt-skel-canvas-dark .ppt-skel-slide-pane {\n    background: #000;\n  }\n  .ppt-skel-canvas-dark .ppt-skel-thumbnails {\n    background: #1B1A19;\n  }\n  @media screen and (-ms-high-contrast: active),\n  screen and (forced-colors: active) {\n    .ppt-skel-canvas-color-parity,\n    .ppt-skel-canvas-color-parity .ppt-skel-slide-pane,\n    .ppt-skel-canvas-color-parity .ppt-skel-thumbnails {\n      background: Canvas;\n      color: CanvasText;\n    }\n    .ppt-skel-canvas-color-parity .ppt-skel-slide,\n    .ppt-skel-canvas-color-parity .ppt-skel-slide-placeholder {\n      border-color: CanvasText;\n    }\n  }\n  .ppt-skel-slide-placeholder {\n    position: absolute;\n    background: #fff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.3);\n    border: solid 1px transparent;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 1200px;\n    height: 675px;\n    max-width: calc(100% - 20px);\n    max-height: calc(100% - 20px);\n  }\n  .ppt-skel-horizontal-handoff-parity .ppt-skel-slide,\n  .ppt-skel-horizontal-handoff-parity .ppt-skel-slide-placeholder {\n    border: 0;\n  }\n  .ppt-skel-slide-shadow-legacy .ppt-skel-slide,\n  .ppt-skel-slide-shadow-legacy .ppt-skel-slide-placeholder {\n    box-shadow: none;\n  }\n  .ppt-skel-slide-shadow-current .ppt-skel-slide,\n  .ppt-skel-slide-shadow-current .ppt-skel-slide-placeholder {\n    box-shadow:\n      0 4px 8px 0 rgba(0, 0, 0, 0.14),\n      0 0 2px 0 rgba(0, 0, 0, 0.12);\n  }\n  @media screen and (-ms-high-contrast: active),\n  screen and (forced-colors: active) {\n    .ppt-skel-slide-shadow-parity .ppt-skel-slide,\n    .ppt-skel-slide-shadow-parity .ppt-skel-slide-placeholder {\n      box-shadow: none;\n      border-color: CanvasText;\n    }\n    .ppt-skel-horizontal-handoff-parity .ppt-skel-slide,\n    .ppt-skel-horizontal-handoff-parity .ppt-skel-slide-placeholder {\n      border: 1px solid CanvasText;\n    }\n  }\n  .ppt-skel-slide-img {\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n  .ppt-skel-sxs-grid-pane {\n    flex: 1 1 auto;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    width: 100%;\n    height: 100%;\n    background: #f0f0f0;\n    overflow: hidden;\n    overscroll-behavior: none;\n    touch-action: none;\n    position: relative;\n    padding: 24px 77px 80px 41px;\n  }\n  .ppt-skel-sxs-grid {\n    display: flex;\n    flex: 0 0 auto;\n    flex-direction: column;\n    align-items: center;\n    width: 100%;\n    container-type: inline-size;\n  }\n  .ppt-skel-sxs-grid .ppt-skel-sxs-slide {\n    position: relative !important;\n    top: auto !important;\n    left: auto !important;\n    transform: none !important;\n    flex: 0 0 auto;\n    width: 100% !important;\n    height: auto !important;\n    max-width: none;\n    max-height: none;\n    aspect-ratio: var(--ppt-skel-sxs-slide-aspect, 16 / 9);\n    overflow: visible;\n    margin: 0 auto 52px auto;\n    container-type: inline-size;\n    border-radius: clamp(8px, 2.2cqw, var(--gnrc-border-radius-composite-large, 24px));\n  }\n  .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n    box-shadow: 0 0 0 2px white;\n    outline: 3px solid rgb(196, 62, 28);\n    outline-offset: 2px;\n  }\n  .ppt-skel-sxs-grid .ppt-skel-slide-img {\n    object-fit: contain;\n    border-radius: clamp(8px, 2.2cqw, var(--gnrc-border-radius-composite-large, 24px));\n  }\n  .ppt-skel-sxs-grid .ppt-skel-sxs-slide.ppt-previewer-slide-image::before {\n    content: \'\';\n    position: absolute;\n    inset: 0;\n    border-radius: clamp(8px, 2.2cqw, var(--gnrc-border-radius-composite-large, 24px));\n    background-color: #ffffff;\n    background-image: var(--ppt-previewer-slide-image);\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: cover;\n  }\n  .ppt-skel-sxs-slide-number {\n    position: absolute;\n    top: calc(100% + 8px);\n    left: 0;\n    font-family: "Segoe Sans", "Helvetica Neue", Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 20px;\n    color: #242424;\n    white-space: nowrap;\n    pointer-events: none;\n  }\n  .ppt-skel-sxs-slide-number-current {\n    font-weight: 600;\n  }\n  [dir="rtl"] .ppt-skel-sxs-slide-number {\n    left: auto;\n    right: 0;\n  }\n  .ppt-skel-sxs-slide-placeholder {\n    background: transparent;\n  }\n  .ppt-skel-sxs-slide-placeholder::before {\n    content: \'\';\n    position: absolute;\n    inset: 0;\n    border-radius: clamp(8px, 2.2cqw, var(--gnrc-border-radius-composite-large, 24px));\n    box-shadow: 0 1px 4px 1px rgba(0, 0, 0, 0.28);\n    background-color: #ffffff;\n    background-image:\n      linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.6) 50%, rgba(255, 255, 255, 0) 100%),\n      url(\'https://cdn.hubblecontent.osi.office.net/m365content/publish/97e03db7-9ecb-4058-881d-b859e4f852b2/image.png\');\n    background-size: 200% 100%, 100% 100%;\n    background-position: -200% 0, center;\n    background-repeat: no-repeat, no-repeat;\n    animation: ppt-skel-sxs-slide-shimmer-sweep 6s linear infinite;\n    pointer-events: none;\n  }\n  @keyframes ppt-skel-sxs-slide-shimmer-sweep {\n    0% {\n      background-position: -200% 0, center;\n    }\n    100% {\n      background-position: 200% 0, center;\n    }\n  }\n  @media screen and (prefers-reduced-motion: reduce) {\n    .ppt-skel-sxs-slide-placeholder::before {\n      animation: none;\n    }\n  }\n  @media screen and (forced-colors: active) {\n    .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n      outline-color: Highlight;\n    }\n    .ppt-skel-sxs-slide-placeholder::before {\n      background-color: Canvas;\n      background-image: none;\n      animation: none;\n      forced-color-adjust: none;\n    }\n  }\n  /*\n   * SxS Previewer V3 treatment.\n   *\n   * V3 is a two-pane read-only previewer (left thumbnail rail, center stage\n   * slide) under a slim title bar, unlike the V2 single centered vertical grid.\n   * The rail reuses the shared boot-grid tiles so updateSxsBootGrid keeps\n   * filling thumbnails; the stage mirrors slide 0.\n   */\n  .ppt-skel-sxs-v3 .ppt-skel-body {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    height: 100%;\n  }\n  .ppt-skel-sxs-v3-shell {\n    flex: 1 1 auto;\n    display: flex;\n    flex-direction: column;\n    min-height: 0;\n    width: 100%;\n    background: #faf9f8;\n  }\n  .ppt-skel-sxs-v3-main {\n    flex: 1 1 auto;\n    display: flex;\n    min-height: 0;\n  }\n  .ppt-skel-sxs-v3-rail {\n    flex: 0 0 232px;\n    background-color: #ffffff;\n    background-image: linear-gradient(to bottom, #ffffff, #f1f1f1);\n    background-attachment: fixed;\n    background-repeat: repeat-x;\n    border-right: 1px solid #edebe9;\n    overflow: hidden;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid-pane {\n    padding: 16px 12px 24px 28px;\n    background: transparent;\n    align-items: flex-start;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide {\n    margin: 0 auto 18px auto;\n    border-radius: 2px;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-slide-img,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide.ppt-previewer-slide-image::before,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before {\n    border-radius: 2px;\n  }\n  /* Thumbnail images use the app\'s #d2d2d8 border, no shadow (.ThumbnailImageContainer). */\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before {\n    outline-color: #d2d2d8;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-placeholder::before,\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n    box-shadow: none;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-grid .ppt-skel-sxs-slide-selected {\n    outline: 3px solid #f07151;\n    outline-offset: 0;\n  }\n  /*\n   * Thumbnail-pane number matches the app\'s .ThumbnailSlideNumber: a bare "N"\n   * (not "N of total") in a left gutter, #666666, turning #ba3201 when selected.\n   * font-size:0 on the label hides the trailing " of N" text node; the\n   * current-number span restores a visible size.\n   */\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-number {\n    top: 2px;\n    left: -22px;\n    font-size: 0;\n    color: #666666;\n  }\n  .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-number-current {\n    font-size: 13px;\n    font-weight: 400;\n    color: #666666;\n  }\n  .ppt-skel-sxs-v3-rail\n    .ppt-skel-sxs-slide-selected\n    .ppt-skel-sxs-slide-number-current {\n    color: #ba3201;\n  }\n  [dir="rtl"] .ppt-skel-sxs-v3-rail .ppt-skel-sxs-slide-number {\n    left: auto;\n    right: -22px;\n  }\n  /*\n   * V3 slides are flat: a thin #D1D1D1 border and no drop shadow, mirroring\n   * body.PPTPrimusSxsV3Visuals .SlideView / .ppt-previewer-slide-shimmer::before\n   * in Hermes.css (the V2 legacy soft shadow is removed for V3).\n   */\n  .ppt-skel-sxs-v3 .ppt-skel-sxs-slide-placeholder::before {\n    box-shadow: no